# Copy to .env and adjust. The setup-token goes in ./secrets/setup-token, the
# admin token in ./secrets/admin-token, and the TLS certificate in ./certs
# (created by deploy/setup-cert.sh), not here.

# Models blocked for EVERY workstation (comma-separated glob patterns).
# Per-workstation blocks are managed with `gw block`.
# Example: GLOBAL_BLOCKED_MODELS=*fable*
GLOBAL_BLOCKED_MODELS=

# Phase 0 showed Anthropic doesn't need this flag; set to 1 only if 401s appear.
ADD_OAUTH_BETA=0

# 1 = return 404 for paths other than /v1/messages and /v1/messages/count_tokens.
STRICT_PATHS=0

# 1 = log each request's headers (auth headers redacted). Useful for debugging.
LOG_HEADERS=0

# Admin API (/gateway/admin/*): comma-separated addresses allowed to call it,
# e.g. the web portal backend's fixed outbound IP. Empty = any address (the
# admin token is still required). An invalid entry turns the admin API off.
ADMIN_ALLOWED_IPS=

UPSTREAM_BASE_URL=https://api.anthropic.com
